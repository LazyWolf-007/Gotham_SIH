{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/landing/*"],
      "@app/*": ["src/*"],
      "next/link": ["src/landing/components/Link.tsx"],
      "next/image": ["src/landing/components/Image.tsx"],
      "next/navigation": ["src/landing/components/Navigation.ts"]
    }
  },
  "include": ["src"]
}
